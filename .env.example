# Sovereign AI Workbench — Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env with real API keys to version control!

# Server & LAN
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Model Server (Ollama — strictly loopback, never exposed to LAN)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# Cloud Provider Policy
# LOCAL_ONLY = all inference stays local (default, recommended)
# CLOUD_ALLOWED_PUBLIC_ONLY = allow cloud for PUBLIC/INTERNAL data only
CLOUD_POLICY=LOCAL_ONLY

# External API Keys (OPTIONAL — only for cloud fallback on non-confidential data)
# These are read ONLY on the server side. Never exposed to frontend/logs/screenshots.
# Get your keys from:
#   Gemini: https://aistudio.google.com/app/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# Storage & Workspaces
DATABASE_URL=sqlite:///./sovereign_workbench.db
WORKSPACES_DIR=./data/workspaces
BLOBS_DIR=./data/blobs
VECTOR_DB_DIR=./data/indexes

# Security & Sentinel
NETWORK_SENTINEL_INTERVAL_SEC=2.0
REQUIRE_HITL_APPROVAL_FOR_HIGH_RISK=true
ALLOW_EXTERNAL_AI_CALLS=false
